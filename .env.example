# Copie para .env e preencha. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chave grátis do TMDB (filmes): https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Notificações no aparelho (push): chave PÚBLICA do par VAPID (veja supabase/functions/send-push/LEIA-ME.md).
# A chave privada NUNCA vai aqui: ela fica só nos Secrets do Supabase.
VITE_VAPID_PUBLIC_KEY=
